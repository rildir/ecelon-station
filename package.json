{
  "name": "ecelon-station",
  "version": "0.1.0",
  "description": "A control room for Claude Code agent teams: every project is a room in an isometric office, every role a character.",
  "keywords": [
    "claude-code",
    "claude",
    "agents",
    "multi-agent",
    "ai",
    "developer-tools",
    "dashboard",
    "isometric",
    "requirements",
    "traceability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rildir/ecelon-station"
  },
  "homepage": "https://github.com/rildir/ecelon-station#readme",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "ecelon-station": "bin/ecelon-station.js"
  },
  "files": [
    "bin",
    "server",
    "public",
    "demo",
    "docs/i18n.md",
    "scripts",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/ecelon-station.js",
    "demo": "node bin/ecelon-station.js --demo",
    "dev": "node bin/ecelon-station.js --watch",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint . && node scripts/i18n-check.mjs --strict",
    "prepublishOnly": "npm run lint && npm test",
    "dev:demo": "node bin/ecelon-station.js --demo --watch",
    "desktop": "electron desktop/main.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "monaco-editor": "0.57.0",
    "three": "0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "bugs": {
    "url": "https://github.com/rildir/ecelon-station/issues"
  },
  "build": {
    "appId": "dev.ecelon.station",
    "productName": "Ecelon Station",
    "asar": false,
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "server/**",
      "public/**",
      "demo/**",
      "package.json",
      "LICENSE",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/node",
        "to": "node",
        "filter": [
          "node.exe"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ecelon Station"
    },
    "portable": {
      "artifactName": "Ecelon-Station-${version}-portable.exe"
    }
  }
}
